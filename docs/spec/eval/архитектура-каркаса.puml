@startuml архитектура-каркаса
title Архитектура eval-каркаса и поток данных (Р45)
left to right direction

skinparam componentStyle rectangle
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontName "Liberation Sans, sans-serif"
skinparam defaultFontSize 13

skinparam component {
  BackgroundColor #EDE7F6
  BorderColor #5E35B1
  FontColor #1A237E
  BorderThickness 1.2
}

skinparam package {
  BackgroundColor #FFFDE7
  BorderColor #F57F17
  FontColor #BF360C
  BorderThickness 1.2
}

skinparam arrow {
  Color #455A64
  Thickness 1.2
}

' Hub
[Eval Runner\nCLI-интерфейс] as Runner

' Commands (Column 2)
[Replay E1\nПрогон лога] as Replay
[Candidates\nВыгрузка кандидатов] as Candidates
[WCheck\nW-проверка] as WCheck
[LME Convert\nКонвертация LongMemEval] as Lme
[Arms E3\nA/B тестирование] as Arms
[Oracles E4\nМашинные проверки] as Oracles
[Report E5\nСтатистический отчет] as Report
[Runs\nИстория прогонов] as RunsCmd
[DelRun\nУдаление прогона] as DelRunCmd

' Align commands vertically in column 2 (in LR mode, -right-> is vertically downwards)
Replay -[hidden]right-> Candidates
Candidates -[hidden]right-> WCheck
WCheck -[hidden]right-> Lme
Lme -[hidden]right-> Arms
Arms -[hidden]right-> Oracles
Oracles -[hidden]right-> Report
Report -[hidden]right-> RunsCmd
RunsCmd -[hidden]right-> DelRunCmd

' Arrows from Runner to Commands
Runner --> Replay
Runner --> Candidates
Runner --> WCheck
Runner --> Lme
Runner --> Arms
Runner --> Oracles
Runner --> Report
Runner --> RunsCmd
Runner --> DelRunCmd

' Data sources
package "Источники данных" as Sources {
  [Живой лог PG] as SrcPg
  [Фикстуры] as SrcFix
  [LongMemEval] as SrcLme
}

' Replay Pipeline
[Инжестинг\nbatch → LLM → дедуп] as Ingest
[Facts Repository\nХранение фактов] as Repo
[Snapshot Builder\nСборка слепков] as Builder
[Portrait Snapshots\nМатериализация] as Snaps

Replay -down-> Ingest
Sources -down-> Ingest
Ingest -down-> Repo
Repo -down-> Builder
Builder -down-> Snaps

' Keep Sources aligned above Replay pipeline
Replay -[hidden]down-> Sources

' Lifecycle: PG — источник истины (спека 35 §2)
package "gestalt_eval — источник истины" as Lifecycle {
  [Experiments\nреестр, ingest_fp / answer_fp] as Exps
  [Runs\nстадия, статус, экономика] as RunsTbl
  [Answers / Verdicts / WChecks / Snapshots\nканонические артефакты] as Arts
}

[Viewer\nEvalViewerTest — досье точек] as Viewer

RunsCmd --> RunsTbl
DelRunCmd --> RunsTbl
Arms ..> Arts
Oracles ..> Arts
WCheck ..> Arts
Viewer --> Arts
' Layout: lifecycle под пайплайном replay
Repo -[hidden]down-> Exps

note bottom of Lifecycle
  Каждая стадия пишется в обвязке run'а (running → done/failed/interrupted),
  экономика — llm_calls / токены. Смена ingest_fp — новый эксперимент.
  out/ — стираемый дамп (diff/grep, кэш viewer'а).
end note

@enduml
