# Источник: живой лог Honcho (БД honcho_memory), только чтение (read-only пользователь обязателен)
source.db.url=jdbc:postgresql://localhost:5433/honcho_memory
source.db.user=gestalt_ro
source.db.password=

# Цель: память eval (БД gestalt_eval) — факты, слепки, чекпоинты; вся запись ТОЛЬКО сюда. Не путать с honcho_memory!
target.db.url=jdbc:postgresql://localhost:5433/gestalt_eval
target.db.user=gestalt_eval
target.db.password=

# LLM батч-экстракции: OpenAI-совместимый роутер; ключ можно передать env LLM_API_KEY
llm.base-url=https://routerai.ru/api/v1
llm.api-key=
llm.model=deepseek/deepseek-v4-flash-0731
llm.reasoning-effort=low

# Отвечающая модель плеч A/B (E3): любой ключ fallback'ается на llm.*;
# reasoning-effort по умолчанию пуст (ответам рассуждение не нужно)
llm.answer.base-url=
llm.answer.api-key=
llm.answer.model=
llm.answer.reasoning-effort=

# Диапазон дней среза включительно (сессия берётся из sourceSession точек датасета);
# портрет к T копится со всех дней диапазона (план 31 §2.5)
source.day-from=
source.day-to=

# Фикстура вместо живого лога (отладка): путь к jsonl; пусто — живой PG
source.fixture=

# LongMemEval (positive control каркаса / внешний бенчмарк Р37): путь к json-массиву вопросов;
# точки вида lme-<question_id>, портрет каждого вопроса изолирован (project = sourceSession).
# Файл — конфиг oracle (S) с HF xiaowu0162/longmemeval; качается руками: см. README «С нуля»
source.lme.file=data/lme/longmemeval_oracle.json

# Калибровка батчинга (research/25 §1.2)
batch.max-messages=20
batch.max-tokens=2000

# Окно видимого контекста N реплик до M (план 31 §2.3): едино для плеч,
# им же replay вычисляет W0 = window_start(M) для W-проверки
window.size=5

# Гранула слепка (Р32)
portrait.owner=user:anton
portrait.project=project:jrestly

# Датасет точек: рабочий файл разметки E2 (план 31 §2.5) — eval/data, вне VCS;
# для прогона синтетики E2-PC — dataset/points.lme.jsonl (в VCS, см. README «С нуля»)
dataset.file=data/points.live.jsonl

# Тест чистоты системного промпта: список токенов через запятую
# test.prompt.forbidden-tokens=secret1, secret2
